<!doctype html>
<html lang="en"{% if theme != "system" %} data-preview-theme="{{ theme }}"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <base href="../../">
    <title>GitHub Profile README Preview · {{ theme|capitalize }}</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #f6f8fa;
        --surface: #ffffff;
        --text: #1f2328;
        --muted: #59636e;
        --border: #d0d7de;
        --code-bg: #eff2f6;
        --link: #0969da;
        --rule: #d8dee4;
      }

      html[data-preview-theme="dark"] {
        --bg: #0d1117;
        --surface: #0d1117;
        --text: #e6edf3;
        --muted: #9da7b3;
        --border: #30363d;
        --code-bg: #161b22;
        --link: #91cbff;
        --rule: #30363d;
      }

      @media (prefers-color-scheme: dark) {
        html:not([data-preview-theme="light"]) {
          --bg: #0d1117;
          --surface: #0d1117;
          --text: #e6edf3;
          --muted: #9da7b3;
          --border: #30363d;
          --code-bg: #161b22;
          --link: #91cbff;
          --rule: #30363d;
        }
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--text);
      }

      body {
        font: 400 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
        overflow-x: hidden;
      }

      .markdown-body {
        max-width: {{ preview_desktop_width }}px;
        margin: 0 auto;
        padding: 32px 32px 48px;
        color: var(--text);
        overflow-wrap: break-word;
      }

      h1, h2, h3 {
        margin: 24px 0 16px;
        line-height: 1.25;
      }

      h1 {
        padding-bottom: 0.3em;
        border-bottom: 1px solid var(--rule);
        font-size: 2em;
      }

      h2 {
        padding-bottom: 0.3em;
        border-bottom: 1px solid var(--rule);
        font-size: 1.5em;
      }

      h3 {
        font-size: 1.25em;
      }

      p, ol, ul {
        margin: 0 0 16px;
      }

      a {
        color: var(--link);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      code {
        padding: 0.16em 0.35em;
        border-radius: 6px;
        background: var(--code-bg);
        font: 0.9em/1.4 "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
      }

      hr {
        border: 0;
        border-top: 1px solid var(--rule);
        margin: 24px 0;
      }

      img, picture {
        display: block;
        max-width: 100%;
        height: auto;
      }

      picture img {
        width: 100%;
      }

      sub {
        color: var(--muted);
      }

      @media (max-width: 700px) {
        .markdown-body {
          padding: 20px 16px 32px;
        }
      }
    </style>
  </head>
  <body>
    <article class="markdown-body">
      {{ readme_html | safe }}
    </article>
    <script>
      function withCacheBust(url, token) {
        if (!url) {
          return url;
        }
        const joiner = url.includes("?") ? "&" : "?";
        return `${url}${joiner}preview=${token}`;
      }

      (function bustPreviewAssetCache() {
        const token = String(Date.now());
        for (const image of document.querySelectorAll("img")) {
          image.src = withCacheBust(image.getAttribute("src"), token);
        }
        for (const source of document.querySelectorAll("source")) {
          source.srcset = withCacheBust(source.getAttribute("srcset"), token);
        }
      })();
    </script>
  </body>
</html>
