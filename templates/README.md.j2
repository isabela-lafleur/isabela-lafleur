<!-- Generated file. Edit data/profile.yml or design/tokens.yml and rebuild with python3 scripts/build_profile.py -->
{% macro themed_picture(base_name, alt) -%}
<picture>
  <source media="(max-width: {{ mobile_breakpoint }}px) and (prefers-color-scheme: dark)" srcset="./assets/generated/{{ base_name }}-mobile-dark.svg">
  <source media="(max-width: {{ mobile_breakpoint }}px) and (prefers-color-scheme: light)" srcset="./assets/generated/{{ base_name }}-mobile-light.svg">
  <source media="(prefers-color-scheme: dark)" srcset="./assets/generated/{{ base_name }}-dark.svg">
  <source media="(prefers-color-scheme: light)" srcset="./assets/generated/{{ base_name }}-light.svg">
  <img src="./assets/generated/{{ base_name }}-light.svg" width="100%" alt="{{ alt }}">
</picture>
{%- endmacro %}
{% if "hero" in enabled_sections %}
{{ themed_picture("hero", hero_alt) }}

<p align="center"><sub>{{ molecule_of_the_month.label }} · {{ molecule_of_the_month.month_year }} · <a href="{{ molecule_of_the_month.article_url }}">{{ molecule_of_the_month.title }}</a></sub></p>
{% endif %}

