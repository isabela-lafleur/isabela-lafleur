<svg xmlns="http://www.w3.org/2000/svg" viewBox="{{ viewbox }}" role="img" aria-label="Featured work widget">
  <!-- Generated file. Edit data/profile.yml or design/tokens.yml and rebuild. -->
  <defs>
    <style>
      {{ style_block }}
    </style>
  </defs>
  <rect width="{{ width }}" height="{{ height }}" rx="24" fill="{{ colors.background }}"/>
  <rect x="{{ panel.x }}" y="{{ panel.y }}" width="{{ panel.width }}" height="{{ panel.height }}" rx="{{ panel.radius }}" fill="{{ colors.panel }}" stroke="{{ colors.border }}"/>
  <text x="{{ heading.x }}" y="{{ section_y }}" class="widget-section">{{ section_label }}</text>
  <text x="{{ heading.x }}" y="{{ heading.y }}" class="widget-heading">
    {% for line in heading.lines %}
    <tspan x="{{ heading.x }}" dy="{{ 0 if loop.first else heading.leading }}">{{ line }}</tspan>
    {% endfor %}
  </text>

  {% for card in cards %}
  <rect x="{{ card.x }}" y="{{ card.y }}" width="{{ card.width }}" height="{{ card.height }}" rx="16" fill="{{ colors.background }}" stroke="{{ colors.border }}" data-container-id="featured-card-{{ loop.index0 }}"/>
  <text x="{{ card.meta.x }}" y="{{ card.meta.y }}" class="widget-meta">
    {% for line in card.meta.lines %}
    <tspan x="{{ card.meta.x }}" dy="{{ 0 if loop.first else card.meta.leading }}">{{ line }}</tspan>
    {% endfor %}
  </text>
  <text x="{{ card.title.x }}" y="{{ card.title.y }}" class="widget-title-featured">
    {% for line in card.title.lines %}
    <tspan x="{{ card.title.x }}" dy="{{ 0 if loop.first else card.title.leading }}">{{ line }}</tspan>
    {% endfor %}
  </text>
  <text x="{{ card.body.x }}" y="{{ card.body.y }}" class="widget-body">
    {% for line in card.body.lines %}
    <tspan x="{{ card.body.x }}" dy="{{ 0 if loop.first else card.body.leading }}">{{ line }}</tspan>
    {% endfor %}
  </text>
  <text x="{{ card.repository.x }}" y="{{ card.repository.y }}" class="widget-meta">
    {% for line in card.repository.lines %}
    <tspan x="{{ card.repository.x }}" dy="{{ 0 if loop.first else card.repository.leading }}">{{ line }}</tspan>
    {% endfor %}
  </text>
  {% for topic in card.topics %}
  <rect x="{{ topic.x }}" y="{{ topic.y }}" width="{{ topic.width }}" height="{{ topic.height }}" rx="10" fill="{{ colors.trace_fill }}" opacity="0.85"/>
  <text x="{{ topic.text_x }}" y="{{ topic.text_y }}" class="widget-tag" text-anchor="middle">{{ topic.text }}</text>
  {% endfor %}
  {% endfor %}
</svg>
